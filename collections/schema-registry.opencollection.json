                "description": "Version number or 'latest'"
              },
              {
                "name": "deleted",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get schema by version"
        },
        {
          "info": {
            "name": "Delete schema version",
            "type": "http"
