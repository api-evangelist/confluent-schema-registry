              {
                "name": "subject",
                "value": "",
                "type": "path"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              },
              {
                "name": "permanent",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Delete schema version"
